index 0000000000000000000000000000000000000000..d39fbd3dcdae04f9a51f0de6427e60f7f4f9644e
--- /dev/null
+++ b/eval_utils/rocob_utils.py
@@ -0,0 +1,39 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+#
+# This source code is licensed under the license found in the
+# LICENSE file in the root directory of this source tree.
+# ROCOB authors added the fixed-rank DMA update to the SpinQuant integration.
+
+import torch
+
+
+def _lowrank_approx(matrix: torch.Tensor, target_rank: int) -> torch.Tensor:
+    rank = min(target_rank, *matrix.shape)
+    if target_rank <= 3:
+        U, S, V = torch.svd_lowrank(matrix, q=rank, niter=3)
+        return U @ torch.diag(S) @ V.transpose(-2, -1)
+
+    U, S, Vh = torch.linalg.svd(matrix, full_matrices=False)
+    return U[:, :rank] @ (S[:rank].unsqueeze(1) * Vh[:rank, :])
+
+
+def apply_dma(
+    H: torch.Tensor, W: torch.Tensor, Q: torch.Tensor, pac_rank: int, ogc_rank: int
+) -> torch.Tensor:
+    """Fit PAC on the original Gram matrix, then fit OGC on the merged residual."""
+    if pac_rank > 0:
+        h_float = H.float()
+        weighted_fit = _lowrank_approx((W - Q).float() @ h_float, pac_rank)
+        # Right division by symmetric H via a transposed solve.
+        try:
+            pac_update = torch.linalg.solve(h_float, weighted_fit.T).T
+        except torch.linalg.LinAlgError:
+            pac_update = weighted_fit @ torch.linalg.pinv(h_float)
+        Q = Q + pac_update.to(Q)
+
+    if ogc_rank > 0:
+        ogc_update = _lowrank_approx((W - Q).float(), ogc_rank)
+        Q = Q + ogc_update.to(Q)
+
+    return Q
